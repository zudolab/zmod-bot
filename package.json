{
  "name": "zmod-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "policy:build": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/build-policy.mjs",
    "predev": "pnpm policy:build",
    "predeploy": "pnpm policy:build",
    "pretypecheck": "pnpm policy:build",
    "pretest": "pnpm policy:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:build": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/build-seed-migration.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260807.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
